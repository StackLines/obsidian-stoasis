{
	"name": "obsidian-stoasis",
	"version": "0.1.0",
	"description": "Sync Obsidian notes in real time and tag their frontmatter, using a compatible self-hosted server.",
	"main": "main.js",
	"type": "module",
	"private": true,
	"license": "MIT",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json && eslint .",
		"test": "vitest run",
		"test:watch": "vitest",
		"leak-check": "node scripts/leak-check.mjs",
		"install-dev": "node scripts/install-dev.mjs",
		"check": "npm run lint && npm run test && npm run build && node scripts/check-readme-status.mjs && npm run leak-check",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [],
	"devDependencies": {
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"@eslint/js": "^9.39.5",
		"@hocuspocus/server": "4.7.0",
		"@types/node": "^22.20.4",
		"@types/ws": "8.18.2",
		"esbuild": "0.25.5",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"fake-indexeddb": "6.2.5",
		"globals": "^17.12.0",
		"jiti": "^2.7.0",
		"obsidian": "1.13.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.71.0",
		"vitest": "4.1.11",
		"ws": "8.22.0"
	},
	"overrides": {
		"moment": "2.31.0"
	},
	"dependencies": {
		"@hocuspocus/provider": "4.7.0",
		"y-indexeddb": "9.0.12",
		"y-protocols": "1.0.7",
		"yjs": "13.6.33"
	}
}
