{
	"name": "obsidian-stoa",
	"version": "0.0.1",
	"description": "Real-time note sync and frontmatter tagging for Obsidian, against a compatible self-hosted server.",
	"main": "main.js",
	"type": "module",
	"private": true,
	"license": "MIT",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json && eslint .",
		"test": "vitest run",
		"test:watch": "vitest",
		"leak-check": "node scripts/leak-check.mjs",
		"check": "npm run lint && npm run test && npm run build && node scripts/check-readme-status.mjs && npm run leak-check",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [],
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@types/node": "^22.20.4",
		"esbuild": "0.25.5",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.12.0",
		"jiti": "^2.7.0",
		"obsidian": "1.13.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.71.0",
		"vitest": "4.1.11"
	},
	"overrides": {
		"moment": "2.31.0"
	}
}
